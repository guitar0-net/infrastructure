// Discover all running Docker containers
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

// Filter to guitar0-backend project containers only and add labels
discovery.relabel "guitar0_containers" {
  targets = discovery.docker.containers.targets

  // Keep only containers from guitar0-backend compose projects (any env: dev/staging/production)
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "guitar0-backend.*"
    action        = "keep"
  }

  // Add container name label (strip leading slash)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Add compose service name label
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Add environment label (development / staging / production)
  rule {
    source_labels = ["__meta_docker_container_label_environment"]
    target_label  = "env"
  }
}

// Collect logs from Docker container stdout/stderr
loki.source.docker "guitar0_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.guitar0_containers.output
  forward_to = [loki.process.drop_probes.receiver]
}

// Drop gunicorn access lines for successful Prometheus scrapes and Docker healthchecks
// Dropped volume: loki_process_dropped_lines_total{reason="probe_noise"}.
loki.process "drop_probes" {
  stage.drop {
    expression          = `"GET /(?:metrics|health)/ HTTP/[0-9.]+" 2[0-9]{2} `
    drop_counter_reason = "probe_noise"
  }

  forward_to = [loki.process.extract_level.receiver]
}

// Extract log level and attach it as a Loki label so dashboards can filter by level.
// Matches either the first word of the line (e.g. "INFO ...", "WARNING ...", the
// shape emitted by Django/gunicorn) or a bracketed "[LEVEL]" token anywhere in the
// line (e.g. "[1] [INFO] ..."), so a source that doesn't put the level first still
// gets picked up instead of silently falling into UNKNOWN.
// Lines that match neither get level=UNKNOWN so the stream selector level=~".+" always works.
loki.process "extract_level" {
  stage.regex {
    expression = `(?:^(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL)\b)|(?:\[(?P<level_bracketed>DEBUG|INFO|WARNING|ERROR|CRITICAL)\])`
  }

  stage.template {
    source   = "level"
    template = `{{ if .level }}{{ .level }}{{ else if .level_bracketed }}{{ .level_bracketed }}{{ else }}UNKNOWN{{ end }}`
  }

  stage.labels {
    values = { level = "level" }
  }

  forward_to = [loki.write.local.receiver]
}

// Send logs to Loki
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
