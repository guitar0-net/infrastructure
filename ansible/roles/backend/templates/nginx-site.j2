# Nginx vhost for {{ backend_app_name }} ({{ app_env }})
# SSL will be added by: certbot --nginx {% for d in backend_nginx_domains %}-d {{ d.server_name }} {% endfor %}

{%- macro security_headers(domain, indent) %}
{% if domain.x_frame_options is defined %}
{{ indent }}add_header X-Frame-Options "{{ domain.x_frame_options }}" always;
{% endif %}
{{ indent }}add_header X-Content-Type-Options "nosniff" always;
{{ indent }}add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{%- endmacro %}
{% for domain in backend_nginx_domains %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain.server_name }};

    # Per-vhost access log in the `timing` format (defined in
    # conf.d/log-format.conf) instead of the inherited `combined` one. This is
    # the only place that sees how long a request took end to end, including
    # the wait in front of the gunicorn workers and the write-out to the
    # client. Rotated by the stock /etc/logrotate.d/nginx glob.
    access_log /var/log/nginx/{{ domain.server_name }}.timing.log timing;

    # Security headers
{{ security_headers(domain, "    ") }}

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml application/xml+rss text/javascript;

{% if domain.serve_static | default(false) %}
    location /static/ {
        alias {{ backend_shared_dir }}/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
{{ security_headers(domain, "        ") }}
        access_log off;
    }

{% endif %}
{% if domain.serve_media | default(false) %}
    location /media/ {
        alias {{ backend_shared_dir }}/media/;
        expires 7d;
        add_header Cache-Control "public";
{{ security_headers(domain, "        ") }}
        access_log off;
    }

{% endif %}
{% for loc in domain.locations %}
    location {{ loc.path }} {
{% if loc.rate_limit is defined %}
        limit_req zone={{ loc.rate_limit }} burst={{ loc.burst | default(20) }} nodelay;
{% endif %}
{% if loc.allow_only is defined %}
{% for addr in loc.allow_only %}
        allow {{ addr }};
{% endfor %}
        deny all;
{% endif %}
{% if loc.return is defined %}
        return {{ loc.return }};
{% else %}
        proxy_pass http://127.0.0.1:{{ backend_app_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if loc.timeout | default(false) %}
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
{% endif %}
{% if loc.cache | default(false) %}
        # Only successful responses are cached — errors always hit the backend.
        proxy_cache guitar0_cache;
        proxy_cache_valid 200 {{ loc.cache_valid | default("60s") }};
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status always;
{{ security_headers(domain, "        ") }}
{% endif %}
{% endif %}
    }

{% endfor %}
}

{% endfor %}
