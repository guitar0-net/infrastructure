{% set app_hosts = backend_nginx_domains | map(attribute='server_name') | list %}
DEBUG=False
ENVIRONMENT={{ app_env }}
SECRET_KEY={{ backend_secret_key }}
DATABASE_URL=postgres://{{ backend_db_user }}:{{ backend_db_password }}@db:5432/{{ backend_db_name }}
ALLOWED_HOSTS={{ (app_hosts + ['127.0.0.1', 'localhost', backend_app_name ~ '-app-1']) | to_json }}
CSRF_TRUSTED_ORIGINS={{ app_hosts | map('regex_replace', '^', 'https://') | list | to_json }}
GIT_SHA={{ lookup('env', 'GIT_SHA') | default('unknown', true) }}
GUNICORN_WORKERS={{ backend_gunicorn_workers }}
{% if backend_google_play_package_name %}
GOOGLE_PLAY_PACKAGE_NAME={{ backend_google_play_package_name }}
{% endif %}
{% if backend_google_play_service_account_info %}
GOOGLE_PLAY_SERVICE_ACCOUNT_INFO={{ backend_google_play_service_account_info | to_json }}
{% endif %}
{% if backend_apple_bundle_id %}
APPLE_BUNDLE_ID={{ backend_apple_bundle_id }}
{% endif %}
{% if backend_apple_app_apple_id %}
APPLE_APP_APPLE_ID={{ backend_apple_app_apple_id }}
{% endif %}
