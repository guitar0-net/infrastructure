# Production docker-compose for backend
# Host nginx is used as reverse proxy (not containerized)

name: {{ backend_app_name }}

services:
  app:
    image: {{ backend_docker_image }}:{{ backend_docker_tag }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ backend_app_port }}:8000"
    env_file:
      - {{ backend_shared_dir }}/.env
    environment:
      # Shared store for prometheus_client's cross-worker metric values — see
      # the bootstrap block at the top of config/gunicorn.py. Without it each
      # gunicorn worker answers /metrics/ with only its own share of the
      # traffic, and consecutive scrapes hitting different workers make every
      # counter look like it keeps resetting.
      PROMETHEUS_MULTIPROC_DIR: /run/prometheus
    tmpfs:
      # Backing store for the above: empty on every container start, so stale
      # counters from a previous run cannot be summed into the new ones, and
      # never touching the disk. Holds four 64 KiB mmap files per process, so
      # roughly 1 MiB in steady state — the rest is headroom.
      - /run/prometheus:size=64m,mode=1777
    volumes:
      - {{ backend_shared_dir }}/staticfiles:/app/staticfiles
      - {{ backend_shared_dir }}/media:/app/media
      - {{ backend_log_dir }}:/app/logs
    labels:
      - "prometheus.io/scrape=true"
      - "prometheus.io/job=guitar0-backend"
      - "prometheus.io/path=/metrics/"
      - "prometheus.io/port=8000"
      - "environment={{ app_env }}"
    networks:
      - default
      - guitar0-network
    depends_on:
      db:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "{{ backend_app_cpu_limit }}"
          memory: {{ backend_app_memory_limit }}
        reservations:
          cpus: "{{ backend_app_cpu_reservation }}"
          memory: {{ backend_app_memory_reservation }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  db:
    image: postgres:16-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ backend_db_docker_port }}:5432"
    environment:
      POSTGRES_DB: {{ backend_db_name }}
      POSTGRES_USER: {{ backend_db_user }}
      POSTGRES_PASSWORD: {{ backend_db_password }}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    deploy:
      resources:
        limits:
          cpus: "{{ backend_db_cpu_limit }}"
          memory: {{ backend_db_memory_limit }}
        reservations:
          cpus: "{{ backend_db_cpu_reservation }}"
          memory: {{ backend_db_memory_reservation }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ backend_db_user }} -d {{ backend_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:

networks:
  default:
  guitar0-network:
    external: true
