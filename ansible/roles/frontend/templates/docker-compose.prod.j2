# Production docker-compose for frontend (Next.js SSR)
# Host nginx is used as reverse proxy (not containerized)

name: {{ frontend_app_name }}

services:
  app:
    image: {{ frontend_docker_image }}:{{ frontend_docker_tag }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ frontend_app_port }}:3000"
    env_file:
      - {{ frontend_shared_dir }}/.env
    volumes:
      - {{ frontend_log_dir }}:/app/logs
    labels:
      - "prometheus.io/scrape=true"
      - "prometheus.io/job=guitar0-frontend"
      - "prometheus.io/path=/metrics"
      - "prometheus.io/port=3000"
      - "environment={{ app_env }}"
    networks:
      - guitar0-network
    deploy:
      resources:
        limits:
          cpus: "{{ frontend_app_cpu_limit }}"
          memory: {{ frontend_app_memory_limit }}
        reservations:
          cpus: "{{ frontend_app_cpu_reservation }}"
          memory: {{ frontend_app_memory_reservation }}

networks:
  guitar0-network:
    external: true
